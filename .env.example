# Salin ke .env.local. Jangan mengisi rahasia sungguhan di berkas contoh.
# Basis lokal sekali pakai. Bukan DATABASE_URL produksi atau Darul Hikam.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/digidonasi

# Hanya string true yang menyalakan website. Nilai lain, termasuk kosong, berarti mati.
WEBSITE_ENABLED=false

# Branding generik untuk tampilan saat basis belum terbaca. Bukan nama klien terkunci.
ORG_NAME=[DEMO] Lembaga Contoh
ORG_SHORT_NAME=DEMO
ORG_TAGLINE=[DEMO] Bukan lembaga sungguhan
ORG_PRIMARY_COLOR=#01665e
ORG_SIDEBAR_COLOR=#01665e
ORG_ACCENT_COLOR=#2e8b7a
PUBLIC_DOMAIN=example.org

# Akun panel hanya terbentuk bila opt-in persis true. Jangan menulis email orang sungguhan.
BOOTSTRAP_ADMIN_OPT_IN=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Hari 2. Kosong pada hari 1. Jangan diisi token di repo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
