# Salin ke .env.local. Jangan mengisi rahasia sungguhan di berkas contoh.
# Basis lokal sekali pakai. Bukan DATABASE_URL produksi atau Darul Hikam.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/digidonasi

# Hanya string true yang menyalakan website. Nilai lain, termasuk kosong, berarti mati.
WEBSITE_ENABLED=false

# Merek contoh fiktif bila basis belum terbaca. Bukan nama klien sungguhan.
ORG_NAME=Yayasan Lentera Barokah
ORG_SHORT_NAME=Lentera
ORG_TAGLINE=Kebaikan yang sampai kepada yang berhak
ORG_PRIMARY_COLOR=#0E6B56
ORG_SIDEBAR_COLOR=#0A3F34
ORG_ACCENT_COLOR=#C5922C
PUBLIC_DOMAIN=example.org

# Akun panel hanya terbentuk bila opt-in persis true. Jangan menulis email orang sungguhan.
BOOTSTRAP_ADMIN_OPT_IN=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Kosong di repo. Isi di mesin klien. AUTH_PROVIDER=mock hanya untuk uji lokal.
# Login Google sungguhan belum tervalidasi di paket ini.
AUTH_PROVIDER=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Pembayaran. Kosong di repo. PAYMENT_MODE=live hanya jika kunci sandbox klien ada.
# Sandbox Xendit/Midtrans belum tervalidasi di paket ini.
PAYMENT_MODE=
PAYMENT_EXPIRY_MINUTES=1440
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
